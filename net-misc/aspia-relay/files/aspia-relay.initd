#!/sbin/openrc-run

supervisor="supervise-daemon"
# OpenRC-сервис Aspia Relay: демон работает в foreground (без аргументов).

description="Aspia Relay: proxies user traffic to bypass NAT"

command="/usr/bin/aspia_relay"
command_user="aspia:aspia"
output_logger="logger -t aspia-relay -p daemon.info"
error_logger="logger -t aspia-relay -p daemon.err"

export ASPIA_LOG_TO_STDOUT="${ASPIA_LOG_TO_STDOUT:-1}"
export ASPIA_LOG_TO_FILE="${ASPIA_LOG_TO_FILE:-0}"

depend() {
	need localmount
	after net
}
